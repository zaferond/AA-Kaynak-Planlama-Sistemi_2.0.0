# Yalnız boş ve ayrı test veritabanı. Uygulamanın .env dosyasını kullanmayın.
TEST_DB_SERVER=sqlserver.sirketiniz.local
TEST_DB_PORT=1433
TEST_DB_DATABASE=AA_KaynakPlanlama_test
TEST_DB_AUTH=sql
TEST_DB_USER=aa_planlama_test
TEST_DB_PASSWORD='TEST_HESABI_SIFRESI'
TEST_DB_ENCRYPT=true
TEST_DB_TRUST_SERVER_CERTIFICATE=false
# Named instance için PORT yerine TEST_DB_INSTANCE kullanın.
# NTLM için TEST_DB_AUTH=ntlm ve TEST_DB_DOMAIN tanımlayın.
