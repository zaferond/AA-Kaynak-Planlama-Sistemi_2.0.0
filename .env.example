# Yerel deneme: npm run setup bunu otomatik oluşturur.
DB_PROVIDER=sqljs
SQLJS_FILE=data/planlama.sqlite
DB_AUTO_MIGRATE=false
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
# Yerel doğrudan kullanımda boş bırakın.
TRUST_PROXY=
PORT=3000
NODE_ENV=development
# İlk yönetici hesabı: ikisini de kendiniz doldurun; boş veya örnek değerle sistem başlamaz.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Windows Active Directory / LDAP (isteğe bağlı; varsayılan kapalı).
# Ayrıntılar: ACTIVE-DIRECTORY-LDAP.md. Gerçek değerleri yalnız .env içinde tutun.
AD_ENABLED=false
# AD_LDAP_URL=ldaps://dc.example.internal:636
# AD_BASE_DN=OU=Employees,DC=example,DC=internal
# AD_BIND_DN=CN=ReadOnlyService,OU=ServiceAccounts,DC=example,DC=internal
# AD_BIND_PASSWORD='IT_TARAFINDAN_TANIMLANACAK'
# AD_GROUP_DN=CN=AA-Portal-Users,OU=Groups,DC=example,DC=internal
# AD_CA_FILE=C:/Certificates/company-ca.pem

# Planlama verisi önbelleği: her kayıtta kendiliğinden yenilenir. Veritabanı
# uygulama dışından (elle SQL) değiştirilirse en geç bu süre içinde görülür.
# 0 önbelleği kapatır. Varsayılan 60000 (60 saniye).
# VIEW_CACHE_MAX_AGE_MS=60000
# Bu süreyi (ms) aşan API istekleri sunucu kaydına tek satır yazılır.
# SLOW_REQUEST_MS=2000
