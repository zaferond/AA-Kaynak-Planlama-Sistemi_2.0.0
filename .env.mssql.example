# IT bilgileriyle doldurun ve .env olarak kullanın. Gerçek şifreleri paylaşmayın.
DB_PROVIDER=mssql
DB_SERVER=sqlserver.sirketiniz.local
DB_PORT=1433
DB_DATABASE=AA_KaynakPlanlama
DB_AUTH=sql
DB_USER=aa_planlama_app
DB_PASSWORD='IT_TARAFINDAN_VERILEN_SIFRE'
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_AUTO_MIGRATE=false
# Named instance kullanılacaksa DB_PORT yerine DB_INSTANCE tanımlayın.
# DB_INSTANCE=INSTANCE_ADI
# Domain kullanıcı adı/parola ile NTLM: DB_AUTH=ntlm ve DB_DOMAIN=DOMAIN
APP_ORIGIN=https://planlama.sirketiniz.com
HOST=127.0.0.1
# Yalnızca HTTPS proxy aynı sunucudaysa loopback kullanın.
# Ayrı sunucudaysa sadece gerçek proxy IP/CIDR adresini yazın.
TRUST_PROXY=loopback
PORT=3000
NODE_ENV=production
ADMIN_USERNAME=mehmetzaferonder@gmail.com
ADMIN_PASSWORD='ILK_KURULUM_ICIN_SIZE_OZEL_SIFRE'

# Windows Active Directory / LDAP (isteğe bağlı; varsayılan kapalı).
# Ayrıntılar: ACTIVE-DIRECTORY-LDAP.md. Gerçek değerleri yalnız .env içinde tutun.
AD_ENABLED=false
# AD_LDAP_URL=ldaps://dc.example.internal:636
# AD_BASE_DN=OU=Employees,DC=example,DC=internal
# AD_BIND_DN=CN=ReadOnlyService,OU=ServiceAccounts,DC=example,DC=internal
# AD_BIND_PASSWORD='IT_TARAFINDAN_TANIMLANACAK'
# AD_GROUP_DN=CN=AA-Portal-Users,OU=Groups,DC=example,DC=internal
# AD_CA_FILE=C:/Certificates/company-ca.pem
