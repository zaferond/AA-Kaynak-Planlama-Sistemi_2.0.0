{
  "name": "aa-kaynak-planlama-mssql",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env backend/server.mjs",
    "build": "npm run typecheck && npm --prefix frontend run build",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node scripts/run-mssql-tests.mjs",
    "bench:store": "node scripts/benchmark-store.mjs",
    "admin:password": "node --env-file=.env backend/admin-password.mjs",
    "setup": "node backend/setup.mjs",
    "db:migrate": "node --env-file=.env backend/migrate.mjs",
    "db:check": "node --env-file=.env backend/check-db.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "pretest": "npm run check:domain",
    "pretest:db": "npm run check:domain",
    "check:domain": "node scripts/check-domain.mjs",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "verify": "npm run format:check && npm test && npm run build",
    "test:ui": "node scripts/run-browser-checks-isolated.mjs",
    "pretest:ui": "npm run build",
    "db:backup": "node scripts/data-maintenance.mjs backup",
    "db:verify-backup": "node scripts/data-maintenance.mjs verify",
    "db:prepare-recovery": "node scripts/data-maintenance.mjs prepare-recovery",
    "audit:archive": "node scripts/data-maintenance.mjs archive",
    "audit:retention": "node scripts/data-maintenance.mjs retention",
    "deploy:package": "node scripts/package-deployment.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ldapts": "9.2.0",
    "mssql": "^12.0.0",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "mssql": {
      "tedious": "20.3.8"
    }
  }
}
